[Unit]
Description=YEX SEO Intelligence Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/yex_seo_bot
Environment="PATH=/home/YOUR_USERNAME/yex_seo_bot/venv/bin:/usr/bin"
ExecStart=/home/YOUR_USERNAME/yex_seo_bot/venv/bin/python main.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
