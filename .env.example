# Telegram — where alerts get delivered
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenAI — powers the signal interpretation ("the brain")
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google Search Console — your own site performance signal
GSC_SITE_URL=sc-domain:example.com
# Also requires config/gsc_credentials.json (a GCP service account key file)
# — this is NOT an env var, it's a separate file. Never commit it.

# Reddit API — trending narrative signal
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Editorial context override — leave unset to use the generic default
# baked into settings.py. Set this in production (e.g. Railway) with
# your real client-specific editorial rules.
EDITORIAL_CONTEXT=
